TELEGRAM_BOT_TOKEN=your-bot-token-here

# Optional: only needed if Telegram is blocked on your network and you're not
# using a system-wide VPN. Example: http://127.0.0.1:7890 or socks5://127.0.0.1:1080
PROXY_URL=

# Comma-separated Telegram user IDs allowed to run admin commands
# (/adduser, /removeuser, /syncclients, /members, etc.). Send /help to the
# bot to see your own ID.
ADMIN_IDS=

# Comma-separated list of channels members must join before using the bot.
# Format per entry: <@username or chat id>|<display label>
# Example: @your_main_channel|Main Channel,@your_backup_channel|Backup Channel
# Leave empty to disable the join gate entirely.
# NOTE: the bot must be an admin in each channel to check membership.
REQUIRED_CHANNELS=

# Lamix agent API token and base URL — used for the client roster, ranges,
# numbers, assign/unassign, and messages endpoints. See lamix_api.py.
LAMIX_API_TOKEN=
LAMIX_BASE_URL=https://panel.lamix.org

# Channel (numeric chat id, e.g. -100xxxxxxxxxx) where the automated traffic
# report is posted every 10 minutes. The bot must be an admin there with
# "Post Messages" permission. Leave empty to disable the traffic job.
TRAFFIC_CHANNEL_ID=
